<?xml version="1.0" encoding="UTF-8"?>
<!--
  Boundary sample built on purpose:
   * P2 overlaps P1 by 1 s: P1=[0,10), P2=[9,17), P3=[17,22)
   * Last segment of P1 (8-12 s relative) and P3 (4-8 s relative)
     extends beyond the owning Period duration.
   * The vhigh segment at media time 540000 (P1 presentation 4-8 s)
     is an empty segment (container without media samples).
   * vhigh uses timescale 90000 + $Time$ + SegmentTimeline,
     vlow  uses timescale 48000 + $Number$ without a timeline,
     so timescale / presentationTimeOffset conversions can be
     cross-checked between Representations.
-->
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" type="static"
     profiles="urn:mpeg:dash:profile:isoff-on-demand:2011"
     mediaPresentationDuration="PT22S" minBufferTime="PT1S">
  <Period id="P1" start="PT0S" duration="PT10S">
    <AdaptationSet id="as-p1-high" contentType="video" segmentAlignment="true">
      <SegmentTemplate timescale="90000" presentationTimeOffset="180000"
                       startNumber="7" sapType="1"
                       initialization="P1/$RepresentationID$/init.mp4"
                       media="P1/$RepresentationID$/chunk-$Number%05u$-$Time$.m4s">
        <SegmentTimeline>
          <S t="180000" d="360000"/>
          <S d="360000"/>
          <S t="900000" d="360000"/>
        </SegmentTimeline>
      </SegmentTemplate>
      <Representation id="vhigh" bandwidth="2000000" mimeType="video/mp4"
                      codecs="avc1.640028" width="1280" height="720"/>
    </AdaptationSet>
    <AdaptationSet id="as-p1-low" contentType="video" segmentAlignment="true">
      <SegmentTemplate timescale="48000" presentationTimeOffset="96000"
                       duration="192000" startNumber="1"
                       initialization="P1/$RepresentationID$/init.mp4"
                       media="P1/$RepresentationID$/chunk-$Number%05u$.m4s"/>
      <Representation id="vlow" bandwidth="800000" mimeType="video/mp4"
                      codecs="avc1.42c01e" width="640" height="360"/>
    </AdaptationSet>
  </Period>
  <Period id="P2" start="PT9S" duration="PT8S">
    <AdaptationSet id="as-p2-high" contentType="video" segmentAlignment="true">
      <SegmentTemplate timescale="90000" startNumber="7" sapType="1"
                       initialization="P2/$RepresentationID$/init.mp4"
                       media="P2/$RepresentationID$/chunk-$Number%05u$-$Time$.m4s">
        <SegmentTimeline>
          <S t="90000" d="360000"/>
          <S t="450000" d="360000"/>
        </SegmentTimeline>
      </SegmentTemplate>
      <Representation id="vhigh" bandwidth="2000000" mimeType="video/mp4"
                      codecs="avc1.640028" width="1280" height="720">
        <!-- Representation level override: only PTO, everything else
             is inherited from the AdaptationSet SegmentTemplate. -->
        <SegmentTemplate presentationTimeOffset="90000"/>
      </Representation>
    </AdaptationSet>
    <AdaptationSet id="as-p2-low" contentType="video" segmentAlignment="true">
      <SegmentTemplate timescale="48000" presentationTimeOffset="96000"
                       duration="192000" startNumber="1"
                       initialization="P2/$RepresentationID$/init.mp4"
                       media="P2/$RepresentationID$/chunk-$Number%05u$.m4s"/>
      <Representation id="vlow" bandwidth="800000" mimeType="video/mp4"
                      codecs="avc1.42c01e" width="640" height="360"/>
    </AdaptationSet>
  </Period>
  <Period id="P3" start="PT17S" duration="PT5S">
    <AdaptationSet id="as-p3-high" contentType="video" segmentAlignment="true">
      <SegmentTemplate timescale="90000" presentationTimeOffset="0"
                       startNumber="7" sapType="1"
                       initialization="P3/$RepresentationID$/init.mp4"
                       media="P3/$RepresentationID$/chunk-$Number%05u$-$Time$.m4s">
        <SegmentTimeline>
          <S t="0" d="360000"/>
          <S t="360000" d="360000"/>
        </SegmentTimeline>
      </SegmentTemplate>
      <Representation id="vhigh" bandwidth="2000000" mimeType="video/mp4"
                      codecs="avc1.640028" width="1280" height="720"/>
    </AdaptationSet>
    <AdaptationSet id="as-p3-low" contentType="video" segmentAlignment="true">
      <SegmentTemplate timescale="48000" presentationTimeOffset="0"
                       duration="192000" startNumber="1"
                       initialization="P3/$RepresentationID$/init.mp4"
                       media="P3/$RepresentationID$/chunk-$Number%05u$.m4s"/>
      <Representation id="vlow" bandwidth="800000" mimeType="video/mp4"
                      codecs="avc1.42c01e" width="640" height="360"/>
    </AdaptationSet>
  </Period>
</MPD>
