{
  "name": "webtransport-media-buffer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local WebTransport media frame server with bounded reorder buffer, expiry and playout deadlines",
  "scripts": {
    "cert": "bash scripts/gen-cert.sh",
    "start": "node src/server.js",
    "test": "node --test test/reorder-buffer.test.mjs && node --expose-gc test/headless-client.mjs",
    "soak": "node --expose-gc test/soak.mjs",
    "unit": "node --test test/reorder-buffer.test.mjs"
  },
  "dependencies": {
    "@fails-components/webtransport": "^1.6.12",
    "@fails-components/webtransport-transport-http3-quiche": "^1.6.12"
  }
}
