{
  "name": "uid4-0005",
  "version": "1.0.0",
  "description": "Hand-written WebAssembly audio declicker for 48 kHz mono PCM with JS WAV/waveform tooling.",
  "main": "src/declicker.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "node scripts/build-wasm.js && cc -O2 -Wall -Wextra -o build/reference test/reference-main.c -lm",
    "make-audio": "node test/make-test-audio.js",
    "test:unit": "node test/unit-test.js",
    "test:e2e": "node test/run-test.js linear && node test/run-test.js mirror",
    "test:cross": "node test/cross-check.js",
    "test": "npm run build && npm run make-audio && npm run test:unit && npm run test:cross && npm run test:e2e",
    "serve": "node scripts/serve.js"
  },
